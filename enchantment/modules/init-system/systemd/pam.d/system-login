#%PAM-1.0
# For services that log a user in (login, sshd, display managers): adds the
# login uid and registers the session with systemd-logind (pam_systemd), which
# creates XDG_RUNTIME_DIR, starts the user's systemd instance and gives the
# user access to the seat's devices.
auth      include   system-auth
account   required  pam_nologin.so
account   include   system-auth
password  include   system-auth
session   optional  pam_loginuid.so
session   include   system-auth
-session  optional  pam_systemd.so
