#!/bin/sh
# Source Mage (cauldron): OpenRC's rc_shell, installed as
# /sbin/smgl-single-shell by `enchantment install init openrc`.
#
# openrc-init runs rc_shell on the console when the system goes to
# single-user mode (`shutdown now` without -h/-r) and rc does after a failed
# boot. Two things the plain shell doesn't do:
#  - ask for root's password: sulogin (util-linux, built with it by the
#    installer); without it, a root shell with no password check
#  - end the login sessions left on the virtual terminals: OpenRC's single
#    mode stops the agetty services but not the shells they started
#    (sysvinit killed everything on the way to runlevel S), and such a shell
#    keeps reading its VT (through stdin, its controlling terminal is gone
#    with its login process), so it and sulogin split the keystrokes.
#    Services keep running; only what has a VT open is ended.
# Distributed under the terms of the GNU General Public License v2

# processes with a VT (tty1..ttyN) as stdin, stdout or stderr, or as
# controlling terminal; not this script (its own stdio is /dev/console)
vt_processes() {
	for pid in /proc/[0-9]*; do
		pid=${pid#/proc/}
		[ "$pid" = "$$" ] && continue
		[ "$pid" = 1 ] && continue
		for fd in 0 1 2; do
			case "$(readlink "/proc/$pid/fd/$fd" 2>/dev/null)" in
				/dev/tty[1-9]*) echo "$pid"; break ;;
			esac
		done
	done
}

pids=$(vt_processes)
if [ -n "$pids" ]; then
	echo "Ending the login sessions on the virtual terminals: $(echo $pids)"
	kill -HUP $pids 2>/dev/null
	sleep 1
	pids=$(vt_processes)
	[ -n "$pids" ] && kill -KILL $pids 2>/dev/null
fi

for shell in /sbin/sulogin /usr/sbin/sulogin; do
	[ -x "$shell" ] && exec "$shell" "$@"
done
echo "no sulogin: starting a root shell without a password check"
exec /bin/sh -l
