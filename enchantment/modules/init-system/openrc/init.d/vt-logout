#!/sbin/openrc-run
# Source Mage (cauldron): ends the login sessions on the virtual terminals
# when the system goes to single-user mode (enabled in the single runlevel).
# OpenRC's single mode stops the agetty services but not the shells they
# started (killprocs only runs at shutdown), and sulogin then shares the
# console with the old login shell: every keystroke goes to one or the
# other. sysvinit killed all processes on the way to runlevel S; this only
# ends what runs on a VT, so udevd, metalog etc. keep running.
# Distributed under the terms of the GNU General Public License v2

description="Ends the login sessions on the virtual terminals"

depend() {
	keyword -prefix -docker -podman -lxc -jail -vserver
}

# this script and the processes running it (openrc-run, rc, openrc-init):
# in single mode rc has the console, i.e. the VT in front, as its terminal
_ancestors() {
	local pid=$$
	while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
		echo "$pid"
		pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')
	done
}

# the processes on the VTs, without our own
_vt_processes() {
	local ttys t pid skip
	ttys=
	for t in /sys/class/tty/tty[1-9]*; do
		[ -e "$t" ] && ttys="${ttys:+$ttys,}${t##*/}"
	done
	[ -n "$ttys" ] || return 0
	skip=" $(_ancestors | tr '\n' ' ') "
	for pid in $(pgrep -t "$ttys"); do
		case "$skip" in
			*" $pid "*) ;;
			*) echo "$pid" ;;
		esac
	done
}

start() {
	local pids
	pids=$(_vt_processes)
	[ -n "$pids" ] || return 0

	ebegin "Ending the login sessions on the virtual terminals"
	kill -HUP $pids 2>/dev/null
	sleep 1
	pids=$(_vt_processes)
	[ -n "$pids" ] && kill -KILL $pids 2>/dev/null
	eend 0
}
