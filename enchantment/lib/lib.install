#!/bin/bash
#-------------------------------------------------------------------------------
##
##=head1 SYNOPSIS
##
##  Common functions and variables for different installers related to
##  installing content
##
##=head1 DESCRIPTION
##
##  This is all the functions needed for actually installing content (spell
##  sources, spell caches, kernels and modules, etc.) into a target system.
##
##=head1 COPYRIGHT
##
##  Copyright 2009 The Cauldron Team
##
##=head1 FUNCTIONS
##
##=over 4
##
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
##
## @param source
## @param destination
##
## Installs the source file to the destination.
##
#-------------------------------------------------------------------------------
function enchant_install_file() {
  local src="$1"
  local dst="$2"

  [[ -z "$src" ]] && return $ERR_INSTALL_FILE
  [[ -z "$dst" ]] && return $ERR_INSTALL_FILE

  "${ENCHANT_CMD_INSTALL_FILE[@]}" "$src" "$dst" ||
    return $ERR_INSTALL_FILE

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param source
## @param destination
##
## Installs the source directory (including all subdirectories and their
## contents) to the destination.
##
#-------------------------------------------------------------------------------
function enchant_install_dir() {
  local src="$1"
  local dst="$2"

  [[ -z "$src" ]] && return $ERR_INSTALL_DIR
  [[ -z "$dst" ]] && return $ERR_INSTALL_DIR

  "${ENCHANT_CMD_INSTALL_DIR[@]}" "$src" "$dst" ||
    return $ERR_INSTALL_DIR

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param sources_list
##
## Copies the selected spell sources into the target. If sources_list is empty
## (no sources were passed as arguments), it reads the list of sources to
## install from $ENCHANT_SOURCES_LIST.
##
#-------------------------------------------------------------------------------
function enchant_install_sources() {
  local sources=( "$@" )
  local dst="$ENCHANT_TARGET_SOURCES"

  # if no spells were passed in directly, load via the env var
  [[ -n "$sources" ]] || sources=( "${ENCHANT_SOURCES_LIST[@]}" )

  for spell in "${sources[@]}"
  do
    # if the spells are specified via a file, read the file
    if [[ -r "$spell" ]]
    then
      while read s
      do
        enchant_install_file "$ENCHANT_SPELL_SOURCES/$s" "$dst/" ||
          return $ERR_INSTALL_SOURCES
      done < "$spell"
    else
      enchant_install_file "$ENCHANT_SPELL_SOURCES/$spell" "$dst/" ||
        return $ERR_INSTALL_SOURCES
    fi
  done

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param caches_list
##
## Installs the selected spell caches into the target. If caches_list is empty
## (no caches were passed as arguments), it reads the list of caches to
## install from $ENCHANT_CACHES_LIST.
##
## Each cache carries the tablet page of the cast that made it, with the
## answers given then (spell options and optional dependencies). Those answers
## are handed to sorcery in the target, so that it resurrects the caches as
## they are instead of asking again (and defaulting optional dependencies the
## target lacks to "off", although the cached binaries link them). The caches
## of enabled dependencies the target doesn't have yet are added from the ISO.
##
#-------------------------------------------------------------------------------
function enchant_install_caches() {
  local caches=( "$@" )
  local target="$ENCHANT_TARGET"
  local dst="$ENCHANT_TARGET_CACHES"
  local tmp="$ENCHANT_TMP/caches"
  local state="$target/var/state/sorcery"
  local config="$target/etc/sorcery/local/depends"
  local spells=()
  local cache=
  local spell=
  local page=
  local file=
  local dep=
  local index=0
  local missing=

  # if no caches were passed in directly, use the selected ones
  if [[ "${#caches[@]}" -eq 0 && -r "$ENCHANT_CACHES_LIST" ]]
  then
    caches=( $(grep -v '^#' "$ENCHANT_CACHES_LIST") )
  fi
  [[ "${#caches[@]}" -gt 0 ]] || return $ERR_OK

  "${ENCHANT_CMD_MKDIR[@]}" "$dst" "$state/abandoned" "$config" ||
    return $ERR_INSTALL_CACHES

  # (the list grows while looping: dependencies are appended)
  while [[ "$index" -lt "${#caches[@]}" ]]
  do
    cache="${caches[index]}"
    index=$((index+1))

    [[ "$cache" == */* ]] || cache="$ENCHANT_SPELL_CACHES/$cache"
    [[ -f "$cache" ]] || return $ERR_INSTALL_CACHES

    # the tablet page every cache carries: the spell's name and its answers
    "${ENCHANT_CMD_RM_RECURSE_FORCE[@]}" "$tmp" &&
      "${ENCHANT_CMD_MKDIR[@]}" "$tmp" || return $ERR_INSTALL_CACHES
    "${ENCHANT_CMD_TAR[@]}" -xf "$cache" -C "$tmp" --wildcards \
      'var/state/sorcery/tablet/*/*/depends' \
      'var/state/sorcery/tablet/*/*/spell_config*' 2> "$ENCHANT_NULL"
    page=$(ls -d "$tmp"/var/state/sorcery/tablet/*/[0-9]* 2> "$ENCHANT_NULL" |
      sort | tail -n 1)
    [[ -n "$page" ]] || return $ERR_INSTALL_CACHES
    spell="${page%/*}"
    spell="${spell##*/}"

    "${ENCHANT_CMD_CP[@]}" "$cache" "$dst/" || return $ERR_INSTALL_CACHES
    spells+=( "$spell" )

    for file in spell_config spell_config.p
    do
      [[ -f "$page/$file" ]] || continue
      "${ENCHANT_CMD_CP[@]}" "$page/$file" "$config/$spell${file#spell_config}" ||
        return $ERR_INSTALL_CACHES
    done
    [[ -f "$page/depends" ]] || continue
    "${ENCHANT_CMD_CP[@]}" "$page/depends" "$state/abandoned/$spell" ||
      return $ERR_INSTALL_CACHES

    # enabled dependencies (spell:dependency(provider):on:...) that the target
    # doesn't have and that aren't queued yet
    for dep in $(awk -F: '$3 == "on" { sub(/\(.*/, "", $2); print $2 }' \
      "$page/depends")
    do
      grep -q "^$dep:" "$state/packages" 2> "$ENCHANT_NULL" && continue
      [[ " ${spells[*]} ${caches[*]##*/} " == *" $dep"[-\ ]* ]] && continue

      file=$(ls "$ENCHANT_SPELL_CACHES/$dep"-[0-9]*.tar.* 2> "$ENCHANT_NULL" |
        head -n 1)
      if [[ -n "$file" ]]
      then
        libcolor_msg info "$spell needs $dep: adding ${file##*/}"
        caches+=( "$file" )
      else
        libcolor_msg warn \
          "$spell needs $dep, which has no cache here: sorcery will build it"
      fi
    done
  done
  "${ENCHANT_CMD_RM_RECURSE_FORCE[@]}" "$tmp"

  # let sorcery in the target install them, so that it knows about them (it
  # resurrects the caches rather than compiling, since the target's grimoire
  # has the same spell versions); the answers are already there, so don't wait
  # PROMPT_DELAY at every question. PAGER=cat: at the end of a cast, sorcery
  # repeats the spells' notices, in a pager when they are longer than 40
  # lines, which would stop the install until someone quits it (or for
  # sorcery's PAGER_TIMEOUT, 150 s); they stay in the scrollback and in
  # /tmp/cast/backup/<pid>/notice_log in the target
  enchant_chroot_init "$target"
  liberror_check || return $?
  enchant_chroot env PROMPT_DELAY="${PROMPT_DELAY:-0}" PAGER=cat \
    cast "${spells[@]}"
  liberror_check || return $ERR_INSTALL_CACHES
  enchant_chroot_done "$target"
  liberror_check || return $?

  # cast's exit status doesn't tell: it returns 0 when it "drops" spells
  # (e.g. it tried to compile one, and the download failed offline)
  missing=()
  for spell in "${spells[@]}"
  do
    grep -q "^$spell:" "$state/packages" 2> "$ENCHANT_NULL" ||
      missing+=( "$spell" )
  done
  if [[ "${#missing[@]}" -gt 0 ]]
  then
    libcolor_msg error "not installed: ${missing[*]}"
    return $ERR_INSTALL_CACHES
  fi

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param target root
## @param backup directory
## @param spells...
##
## Saves the given spells' files (from their install logs, logs included) and
## their lines in sorcery's packages and depends databases, for
## enchant_install_init_restore.
##
#-------------------------------------------------------------------------------
function enchant_install_init_backup() {
  local target="$1"
  local backup="$2"
  local state="$target/var/state/sorcery"
  local logs="$target/var/log/sorcery"
  local spell=
  local version=
  local file=
  shift 2

  "${ENCHANT_CMD_RM_RECURSE_FORCE[@]}" "$backup" &&
    "${ENCHANT_CMD_MKDIR[@]}" "$backup" || return $ERR_INSTALL_INIT
  : > "$backup/files" && : > "$backup/packages" && : > "$backup/depends" ||
    return $ERR_INSTALL_INIT

  for spell in "$@"
  do
    version=$(awk -F: -v s="$spell" '$1 == s { print $4 }' "$state/packages")
    [[ -n "$version" ]] || continue
    grep "^$spell:" "$state/packages" >> "$backup/packages"
    grep "^$spell:" "$state/depends" >> "$backup/depends"
    for file in "$logs"/{install,md5sum,compile}/"$spell-$version"*
    do
      [[ -e "$file" ]] && echo "${file#$target/}" >> "$backup/files"
    done
    [[ -f "$logs/install/$spell-$version" ]] &&
      sed -n 's:^/::p' "$logs/install/$spell-$version" >> "$backup/files"
  done

  # (directories in the logs would pull in whole trees: files and links only)
  while read -r file
  do
    [[ -f "$target/$file" || -L "$target/$file" ]] && echo "$file"
  done < "$backup/files" > "$backup/files.list"

  "${ENCHANT_CMD_TAR[@]}" -cpf "$backup/files.tar" -C "$target" \
    -T "$backup/files.list" || return $ERR_INSTALL_INIT
}

#-------------------------------------------------------------------------------
##
## @param target root
## @param backup directory (from enchant_install_init_backup)
##
## Puts the saved files back and re-adds the saved database lines.
##
#-------------------------------------------------------------------------------
function enchant_install_init_restore() {
  local target="$1"
  local backup="$2"
  local state="$target/var/state/sorcery"
  local line=
  local db=

  [[ -f "$backup/files.tar" ]] || return $ERR_INSTALL_INIT
  "${ENCHANT_CMD_TAR[@]}" -xpf "$backup/files.tar" -C "$target" ||
    return $ERR_INSTALL_INIT

  for db in packages depends
  do
    while read -r line
    do
      grep -qxF "$line" "$state/$db" || echo "$line" >> "$state/$db"
    done < "$backup/$db"
  done
}

#-------------------------------------------------------------------------------
##
## @param target root
##
## Writes SMGL's settings from /etc/sysconfig into the files systemd reads:
## the console keymap (vconsole.conf), the locale (locale.conf; login shells
## also read /etc/sysconfig/locale via profile.d) and a hardware clock in
## local time (adjtime; systemd assumes UTC without it). Masks the unit
## systemd's SysV compatibility makes of SMGL's /etc/init.d/rc (simpleinit's
## runlevel script), so it can't be started by mistake.
##
#-------------------------------------------------------------------------------
function enchant_install_init_settings_systemd() {
  local target="$1"
  local sysconfig="$target/etc/sysconfig"
  local vconsole="$target/etc/vconsole.conf"
  local keymap=
  local line=

  keymap=$(sed -n 's/^KEYMAP=["'\'']*\([^"'\'']*\).*/\1/p' \
    "$sysconfig/keymap" 2> "$ENCHANT_NULL")
  if [[ -n "$keymap" && "$keymap" != "defkeymap" ]] &&
    ! grep -q '^KEYMAP=' "$vconsole" 2> "$ENCHANT_NULL"
  then
    echo "KEYMAP=$keymap" >> "$vconsole" || return $ERR_INSTALL_INIT
  fi

  # the systemd spell writes FONT=default8x16 into a new vconsole.conf, so
  # systemd-vconsole-setup replaces the kernel's console font (fbcon=font:,
  # or the 16x32 font the kernel picks for large screens) at every boot.
  # SMGL's equivalent is SETFONT_ARGS (empty: keep the kernel's font)
  "${ENCHANT_CMD_SEDFILE[@]}" '/^FONT=default8x16$/d' "$vconsole" \
    2> "$ENCHANT_NULL"
  set -- $(sed -n 's/^SETFONT_ARGS=["'\'']*\([^"'\'']*\).*/\1/p' \
    "$sysconfig/keymap" 2> "$ENCHANT_NULL")
  if [[ -n "$1" && "$1" != -* ]] &&
    ! grep -q '^FONT=' "$vconsole" 2> "$ENCHANT_NULL"
  then
    echo "FONT=$1" >> "$vconsole" || return $ERR_INSTALL_INIT
    shift
    while [[ $# -gt 1 ]]
    do
      case "$1" in
        -m) echo "FONT_MAP=$2" >> "$vconsole" ;;
        -u) echo "FONT_UNIMAP=$2" >> "$vconsole" ;;
      esac || return $ERR_INSTALL_INIT
      shift
    done
  fi

  if [[ -f "$sysconfig/locale" && ! -f "$target/etc/locale.conf" ]]
  then
    grep -E '^(LANG|LC_[A-Z]+)=[^[:space:]]+' "$sysconfig/locale" \
      > "$target/etc/locale.conf" || : > "$target/etc/locale.conf"
  fi

  if grep -qi '^UTC=no' "$sysconfig/hwclock" 2> "$ENCHANT_NULL" &&
    [[ ! -f "$target/etc/adjtime" ]]
  then
    printf '0.0 0 0.0\n0\nLOCAL\n' > "$target/etc/adjtime" ||
      return $ERR_INSTALL_INIT
  fi

  # the kernel mounts / read-only (grub-mkconfig's "ro"); simpleinit and
  # OpenRC remount it read-write anyway, but systemd-remount-fs only applies
  # an fstab entry for /, so without one the root filesystem stays read-only
  if ! awk '$1 !~ /^#/ && $2 == "/" { found = 1 } END { exit !found }' \
    "$target/etc/fstab" 2> "$ENCHANT_NULL"
  then
    libcolor_msg warn "$target/etc/fstab has no line for /: systemd" \
      "would leave the root filesystem read-only. Add one (see" \
      "'todo edit-confs')."
  fi

  # systemd-gpt-auto-generator mounts the ESP the machine booted from on /efi
  # (making that directory) when /boot is already in use; SMGL systems mount
  # their partitions through fstab, so it only adds a second mount point.
  # Removing the link turns it back on
  line="$target/etc/systemd/system-generators"
  if [[ ! -e "$line/systemd-gpt-auto-generator" ]]
  then
    "${ENCHANT_CMD_MKDIR[@]}" "$line" &&
      ln -s /dev/null "$line/systemd-gpt-auto-generator" ||
      return $ERR_INSTALL_INIT
  fi

  if [[ -f "$target/etc/init.d/rc" ]]
  then
    "${ENCHANT_CMD_MKDIR[@]}" "$target/etc/systemd/system" &&
      ln -sfn /dev/null "$target/etc/systemd/system/rc.service" ||
      return $ERR_INSTALL_INIT
  fi

  # util-linux built with systemd installs tmpfiles for uuidd, but nothing
  # creates the user (the systemd spell is built without sysusers). Its id,
  # 241, is free in the grimoire's accounts and groups registries (proposed
  # there for uuidd): -r alone picked 110/127, which the registries give to
  # exim and haldaemon. -r only if 241 is already taken on this system
  if [[ -f "$target/usr/lib/tmpfiles.d/uuidd-tmpfiles.conf" ]] &&
    ! grep -q '^uuidd:' "$target/etc/passwd"
  then
    line="-r"
    grep -q '^[^:]*:[^:]*:241:' "$target/etc/group" || line="-g 241"
    "${ENCHANT_CMD_CHROOT[@]}" "$target" groupadd $line uuidd ||
      return $ERR_INSTALL_INIT
    line="-r"
    grep -q '^[^:]*:[^:]*:241:' "$target/etc/passwd" || line="-r -u 241"
    "${ENCHANT_CMD_CHROOT[@]}" "$target" useradd $line -g uuidd \
      -d /run/uuidd -s /sbin/nologin -c "UUID generator helper daemon" \
      uuidd || return $ERR_INSTALL_INIT
  fi
}

#-------------------------------------------------------------------------------
##
## @param target root
## @param data directory (init-system/openrc)
##
## After openrc is cast: keeps simpleinit's scripts aside (everything in
## /etc/init.d that isn't an openrc script goes to /etc/init.d.simpleinit;
## openrc would list the runlevels directory and fuse's script as services),
## installs the service scripts SMGL's spells don't ship (udev, metalog,
## nscd, sshd, networking, dhcpcd) with their conf.d files and the local.d
## hooks for /etc/sysconfig/bootmisc and haltmisc, enables the services of
## the data's runlevels file (and sshd if it was enabled), and writes SMGL's
## settings from /etc/sysconfig into openrc's conf.d: the hardware clock,
## the keymap, the console font, and the modules of /etc/modules.
##
#-------------------------------------------------------------------------------
function enchant_install_init_settings_openrc() {
  local target="$1"
  local data="$2"
  local sysconfig="$target/etc/sysconfig"
  local initd="$target/etc/init.d"
  local confd="$target/etc/conf.d"
  local old="$target/etc/init.d.simpleinit"
  local file=
  local svc=
  local level=
  local need=
  local value=
  local sshd_on=

  # was sshd enabled under simpleinit?
  [[ -x "$initd/runlevels/%3/sshd" ]] && sshd_on=yes

  for file in "$initd"/*
  do
    [[ -e "$file" || -L "$file" ]] || continue
    [[ "${file##*/}" == "functions.sh" ]] && continue
    if [[ -d "$file" ]] || ! head -n 1 "$file" | grep -q 'openrc-run'
    then
      "${ENCHANT_CMD_MKDIR[@]}" "$old" &&
        mv "$file" "$old/" || return $ERR_INSTALL_INIT
    fi
  done

  "${ENCHANT_CMD_MKDIR[@]}" "$confd" "$target/etc/local.d" ||
    return $ERR_INSTALL_INIT
  for file in "$data/init.d"/*
  do
    "${ENCHANT_CMD_CP[@]}" "$file" "$initd/" &&
      chmod 0755 "$initd/${file##*/}" || return $ERR_INSTALL_INIT
  done
  for file in "$data/conf.d"/*
  do
    [[ -e "$confd/${file##*/}" ]] && continue
    "${ENCHANT_CMD_CP[@]}" "$file" "$confd/" || return $ERR_INSTALL_INIT
  done
  for file in "$data/local.d"/*
  do
    "${ENCHANT_CMD_CP[@]}" "$file" "$target/etc/local.d/" &&
      chmod 0755 "$target/etc/local.d/${file##*/}" || return $ERR_INSTALL_INIT
  done

  # enable services (as rc-update add does: a link in the runlevel)
  while read -r svc level need
  do
    [[ -z "$svc" || "$svc" == \#* ]] && continue
    [[ -z "$need" || -e "$target$need" ]] || continue
    "${ENCHANT_CMD_MKDIR[@]}" "$target/etc/runlevels/$level" &&
      ln -sfn "/etc/init.d/$svc" "$target/etc/runlevels/$level/$svc" ||
      return $ERR_INSTALL_INIT
  done < "$data/runlevels"
  if [[ "$sshd_on" == "yes" && -e "$target/usr/sbin/sshd" ]]
  then
    ln -sfn /etc/init.d/sshd "$target/etc/runlevels/default/sshd" ||
      return $ERR_INSTALL_INIT
  fi

  # the hardware clock in local time (UTC is openrc's default too)
  if grep -qi '^UTC=no' "$sysconfig/hwclock" 2> "$ENCHANT_NULL" &&
    [[ -f "$confd/hwclock" ]]
  then
    "${ENCHANT_CMD_SEDFILE[@]}" 's/^clock=.*/clock="local"/' "$confd/hwclock" ||
      return $ERR_INSTALL_INIT
  fi

  # the console keymap (SMGL's "defkeymap" is the kernel's own: keep "us")
  value=$(sed -n 's/^KEYMAP=["'\'']*\([^"'\'']*\).*/\1/p' \
    "$sysconfig/keymap" 2> "$ENCHANT_NULL")
  if [[ -n "$value" && "$value" != "defkeymap" && -f "$confd/keymaps" ]]
  then
    "${ENCHANT_CMD_SEDFILE[@]}" "s|^keymap=.*|keymap=\"$value\"|" \
      "$confd/keymaps" || return $ERR_INSTALL_INIT
  fi

  # the console font: SETFONT_ARGS' font (empty: keep the kernel's)
  value=$(sed -n 's/^SETFONT_ARGS=["'\'']*\([^"'\'' ]*\).*/\1/p' \
    "$sysconfig/keymap" 2> "$ENCHANT_NULL")
  if [[ -n "$value" && "$value" != -* && -f "$confd/consolefont" ]]
  then
    "${ENCHANT_CMD_SEDFILE[@]}" "s|^consolefont=.*|consolefont=\"$value\"|" \
      "$confd/consolefont" &&
      ln -sfn /etc/init.d/consolefont \
        "$target/etc/runlevels/boot/consolefont" ||
      return $ERR_INSTALL_INIT
  fi

  # /etc/modules (modprobe at boot by simpleinit's modutils): the names go to
  # modules-load.d, which openrc's modules service reads; options to
  # modprobe.d
  if grep -qv '^[[:space:]]*\(#\|$\)' "$target/etc/modules" 2> "$ENCHANT_NULL"
  then
    "${ENCHANT_CMD_MKDIR[@]}" "$target/etc/modules-load.d" \
      "$target/etc/modprobe.d" || return $ERR_INSTALL_INIT
    while read -r svc value
    do
      [[ -z "$svc" || "$svc" == \#* ]] && continue
      echo "$svc" >> "$target/etc/modules-load.d/smgl-modules.conf"
      [[ -n "$value" ]] &&
        echo "options $svc $value" >> "$target/etc/modprobe.d/smgl-modules.conf"
    done < "$target/etc/modules" || return $ERR_INSTALL_INIT
  fi

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param init system: systemd or openrc (simpleinit, the base system's own,
##        is a no-op)
##
## Switches the installed system (ENCHANT_TARGET) to another init system. The
## base system comes with simpleinit-msb; for systemd, sorcery in the target
## casts systemd (with linux-pam, libseccomp, systemd-boot, polkit, dbus with
## systemd support) and recompiles the installed spells that build systemd
## units/libsystemd or PAM support; for openrc, it casts openrc, recompiles
## procps-ng (pidof) and installs the service scripts SMGL's spells don't
## ship. That downloads and compiles, so it needs network access in the live
## system.
##
## The data comes from $ENCHANT_MODULES/init-system/<init>/ (see the README
## there): sorcery answers, spell option presets, the spells the init
## replaces (dispelled first: simpleinit-msb owns /sbin/init, halt, reboot,
## ... too, and dispelling it afterwards would delete the new init's), the
## providers to rewrite in sorcery's records, the spells to recompile, and
## init-specific files.
##
#-------------------------------------------------------------------------------
function enchant_install_init() {
  local init="$1"
  local target="$ENCHANT_TARGET"
  local data="$ENCHANT_MODULES/init-system/$init"
  local state="$target/var/state/sorcery"
  local config="$target/etc/sorcery/local/depends"
  local line=
  local spell=
  local dep=
  local answer=
  local file=
  local recast=()
  local missing=()
  local njobs_file=
  local njobs_temp=
  local rc=
  local backup="$ENCHANT_TMP/init-backup"
  local replaces=()

  case "$init" in
    simpleinit|simpleinit-msb )
      libcolor_msg info \
        "simpleinit-msb is the base system's init: nothing to install"
      return $ERR_OK
      ;;
    systemd|openrc )
      ;;
    * )
      return $ERR_INSTALLER_CMD
      ;;
  esac

  [[ -f "$state/packages" && -d "$data" ]] || return $ERR_INSTALL_INIT

  if grep -q "^$init:" "$state/packages"
  then
    libcolor_msg info "$init is already installed in $target"
    return $ERR_OK
  fi

  # sorcery downloads everything: check the network before touching anything
  if ! "${ENCHANT_CMD_URL_DL[@]}" -q -T 20 -t 2 --spider \
    "$ENCHANT_NET_TEST_URL" > "$ENCHANT_NULL" 2>&1
  then
    libcolor_msg error "no network: can't reach $ENCHANT_NET_TEST_URL" \
      "(see guide network for connecting; nothing was changed)"
    return $ERR_INSTALL_INIT_NET
  fi

  # sorcery's answers: change recorded ones in place (they win over
  # default_depends), including those of casts not committed yet
  touch "$state/default_depends" || return $ERR_INSTALL_INIT
  while read -r line
  do
    [[ -z "$line" || "$line" == \#* ]] && continue
    IFS=: read -r spell dep answer <<< "$line"
    if grep -qE "^$spell:$dep(\([^)]*\))?:" "$state/depends" 2> "$ENCHANT_NULL"
    then
      "${ENCHANT_CMD_SEDFILE[@]}" -E \
        "s/^($spell:$dep(\([^)]*\))?):(on|off):/\1:$answer:/" \
        "$state/depends" || return $ERR_INSTALL_INIT
    else
      echo "$line" >> "$state/default_depends" || return $ERR_INSTALL_INIT
    fi
    file="$state/abandoned/$spell"
    if [[ -f "$file" ]]
    then
      "${ENCHANT_CMD_SEDFILE[@]}" -E \
        "s/^($spell:$dep(\([^)]*\))?):(on|off):/\1:$answer:/" "$file" ||
        return $ERR_INSTALL_INIT
    fi
  done < "$data/depends"

  # providers the new init takes over (systemd replaces eudev as the
  # DEVICE-MANAGER that lvm, cryptsetup-luks, init.d, ... recorded; openrc
  # replaces init.d as smgl-system's INITSCRIPTS)
  while read -r spell dep
  do
    [[ -z "$spell" || "$spell" == \#* ]] && continue
    "${ENCHANT_CMD_SEDFILE[@]}" \
      "s/:$spell($dep):/:$init($dep):/" "$state/depends" ||
      return $ERR_INSTALL_INIT
  done < "$data/providers"

  # spell option presets
  "${ENCHANT_CMD_MKDIR[@]}" "$config" || return $ERR_INSTALL_INIT
  # (sorcery may leave the last line without a newline)
  for file in "$data/presets"/*.p
  do
    [[ -f "$file" ]] || continue
    if [[ -s "$config/${file##*/}" ]]
    then
      echo >> "$config/${file##*/}" || return $ERR_INSTALL_INIT
    fi
    cat "$file" >> "$config/${file##*/}" || return $ERR_INSTALL_INIT
  done

  # kernel messages on the console (see the file)
  if [[ -d "$data/sysctl.d" ]]
  then
    "${ENCHANT_CMD_MKDIR[@]}" "$target/etc/sysctl.d" &&
      "${ENCHANT_CMD_CP[@]}" "$data/sysctl.d"/* "$target/etc/sysctl.d/" ||
      return $ERR_INSTALL_INIT
  fi
  # systemd-sysctl only reads sysctl.d directories, not /etc/sysctl.conf;
  # the usual link keeps the shipped settings (and the user's edits) working
  if [[ "$init" == "systemd" && -f "$target/etc/sysctl.conf" &&
        ! -e "$target/etc/sysctl.d/99-sysctl.conf" ]]
  then
    "${ENCHANT_CMD_MKDIR[@]}" "$target/etc/sysctl.d" &&
      ln -sfn ../sysctl.conf "$target/etc/sysctl.d/99-sysctl.conf" ||
      return $ERR_INSTALL_INIT
  fi

  # the PAM stack (sorcery doesn't replace existing pam.d files)
  if [[ -d "$data/pam.d" ]]
  then
    "${ENCHANT_CMD_MKDIR[@]}" "$target/etc/pam.d" &&
      "${ENCHANT_CMD_CP[@]}" "$data/pam.d"/* "$target/etc/pam.d/" ||
      return $ERR_INSTALL_INIT
  fi

  # name resolution for sorcery's downloads
  if [[ -s /etc/resolv.conf ]]
  then
    "${ENCHANT_CMD_CP[@]}" /etc/resolv.conf "$target/etc/resolv.conf" ||
      return $ERR_INSTALL_INIT
  fi

  # the installed spells to recompile
  while read -r spell
  do
    [[ -z "$spell" || "$spell" == \#* ]] && continue
    grep -q "^$spell:" "$state/packages" && recast+=( "$spell" )
  done < "$data/recast"

  # sorcery compiles with one job (MAKE_NJOBS=1) unless the user set it: use
  # every core for these casts, and put the setting back afterwards
  njobs_file="$target/etc/sorcery/local/compile_config"
  if ! grep -q '^MAKE_NJOBS=' "$njobs_file" 2> "$ENCHANT_NULL"
  then
    njobs_temp="yes"
    if [[ -s "$njobs_file" ]]
    then
      echo >> "$njobs_file" || return $ERR_INSTALL_INIT
    fi
    echo "MAKE_NJOBS=\"$(nproc)\"" >> "$njobs_file" || return $ERR_INSTALL_INIT
    libcolor_msg info "compiling with $(nproc) jobs (MAKE_NJOBS) for now"
  fi

  enchant_chroot_init "$target"
  liberror_check || return $?

  # the spells the new init replaces own files it installs (/sbin/init, ...)
  # or conflict with it (simpleinit-msb and eudev for systemd, simpleinit-msb
  # and init.d for openrc). Keep a copy of their files and sorcery records:
  # if the new init doesn't get installed (a download or build fails), they
  # go back, so the system still boots as before
  replaces=( $(grep -v '^#' "$data/replaces") )
  enchant_install_init_backup "$target" "$backup" "${replaces[@]}" ||
    return $ERR_INSTALL_INIT

  rc=$ERR_OK
  # (PAGER=cat: no pager for sorcery's notices, see enchant_install_caches)
  enchant_chroot env PROMPT_DELAY=0 dispel --nosustain "${replaces[@]}" &&
    enchant_chroot env PROMPT_DELAY=0 PAGER=cat cast "$init" ||
    rc=$ERR_INSTALL_INIT

  if ! grep -q "^$init:" "$state/packages"
  then
    enchant_chroot_done "$target"
    enchant_install_init_restore "$target" "$backup"
    # and the providers other spells recorded (smgl-system's INITSCRIPTS,
    # lvm's DEVICE-MANAGER, ...) point at the replaced spells again
    while read -r spell dep
    do
      [[ -z "$spell" || "$spell" == \#* ]] && continue
      "${ENCHANT_CMD_SEDFILE[@]}" \
        "s/:$init($dep):/:$spell($dep):/" "$state/depends"
    done < "$data/providers"
    [[ "$njobs_temp" == "yes" ]] &&
      "${ENCHANT_CMD_SEDFILE[@]}" '/^MAKE_NJOBS=/d' "$njobs_file"
    libcolor_msg error "$init could not be installed (see sorcery's output" \
      "above); ${replaces[*]} were put back, so the system boots as before." \
      "You can try again once the problem is fixed."
    return $ERR_INSTALL_INIT
  fi

  if [[ "$rc" -eq "$ERR_OK" && "${#recast[@]}" -gt 0 ]]
  then
    enchant_chroot env PROMPT_DELAY=0 PAGER=cat cast -c "${recast[@]}" ||
      rc=$ERR_INSTALL_INIT
  fi

  enchant_chroot_done "$target"

  if [[ "$njobs_temp" == "yes" ]]
  then
    "${ENCHANT_CMD_SEDFILE[@]}" '/^MAKE_NJOBS=/d' "$njobs_file"
  fi

  [[ "$rc" -eq "$ERR_OK" ]] || return $rc

  # SMGL's own settings (/etc/sysconfig) in the files the new init reads, and
  # its services
  "enchant_install_init_settings_$init" "$target" "$data" ||
    return $ERR_INSTALL_INIT

  # sshd only goes through PAM (and so pam_systemd) with UsePAM
  file="$target/etc/ssh/sshd_config"
  [[ "$init" == "systemd" ]] || file=/nonexistent
  # (the first setting wins, and a line appended at the end could land in a
  # Match block, so replace the commented default or put it first)
  if [[ -f "$file" ]] && ! grep -q '^UsePAM' "$file"
  then
    if grep -q '^#UsePAM' "$file"
    then
      "${ENCHANT_CMD_SEDFILE[@]}" '0,/^#UsePAM.*/s//UsePAM yes/' "$file"
    else
      "${ENCHANT_CMD_SEDFILE[@]}" '1i UsePAM yes' "$file"
    fi || return $ERR_INSTALL_INIT
  fi

  # cast's exit status doesn't tell whether everything was installed
  for spell in $(grep -v '^#' "$data/check") "${recast[@]}"
  do
    grep -q "^$spell:" "$state/packages" 2> "$ENCHANT_NULL" ||
      missing+=( "$spell" )
  done
  if [[ "${#missing[@]}" -gt 0 ]]
  then
    libcolor_msg error "not installed: ${missing[*]}"
    return $ERR_INSTALL_INIT
  fi

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param sys iaage archive file
##
## Unpacks the given sys image to the target system. If the sys image is not
## specified, it defaults to ENCHANT_SYSTEM_ARCHIVE.
##
#-------------------------------------------------------------------------------
function enchant_install_system() {
  local sys="${1:-$ENCHANT_SYSTEM_ARCHIVE}"
  local dst="$ENCHANT_TARGET"

  # ensure that the sys image is a file
  [[ -f "$sys" ]] || return $ERR_INSTALL_SYSTEM

  # as distributions unpack their base tarballs (Gentoo's handbook: xpf with
  # --xattrs-include='*.*' --numeric-owner): permissions, extended
  # attributes (file capabilities), and owners by number, not by name (names
  # would go through the live system's /etc/passwd, not the target's)
  "${ENCHANT_CMD_TAR[@]}" -C "$dst" -xpf "$sys" --xattrs \
    --xattrs-include='*' --numeric-owner ||
    return $ERR_INSTALL_SYSTEM

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param kernel_image (absolute path - e.g. $ENCHANT_ISO_PATH/boot/kernel)
## @param modules_path (absolute path - e.g. $ENCHANT_ISO_PATH/lib/modules)
## @param kernel_version (e.g. 6.18.59)
## @param kernel_type (e.g. linux)
##
## Copies the kernel and it's associated modules from the ISO to the TARGET
## system. Requires that / and /boot on the TARGET system are mounted (unless
## ENCHANT_TARGET_KERNEL and ENCHANT_TARGET_KMODS are modified). The modules
## are taken from modules_path/kernel_version, and the ISO's firmware
## (ENCHANT_ISO_FIRMWARE) is copied along. A linux kernel is installed as
## ENCHANT_TARGET_KERNEL-kernel_version (the name grub-mkconfig looks for),
## together with its config-kernel_version and System.map-kernel_version if
## they are next to the image.
##
#-------------------------------------------------------------------------------
function enchant_install_kernel() {
  local target="$ENCHANT_TARGET"
  local target_kernel="$ENCHANT_TARGET_KERNEL"
  local target_kmods="$ENCHANT_TARGET_KMODS"
  local kernel="${1:-$ENCHANT_ISO_KERNEL}"
  local kmods="${2:-$ENCHANT_ISO_KMODS}"
  local kvers="${3:-$ENCHANT_ISO_KVERS}"
  local ktype="${4:-$ENCHANT_KERNEL_TYPE}"
  local kconfig=

  # the image may be a symlink (/boot/kernel on the ISO); copy what it points to
  kernel=$("${ENCHANT_CMD_READLINK[@]}" "$kernel") || return $ERR_INSTALL_KERNEL

  case "$ktype" in
    linux)
      enchant_install_file "$kernel" "$target_kernel-$kvers" ||
        return $ERR_INSTALL_KERNEL

      for kconfig in "${kernel%/*}/config-$kvers" \
        "${kernel%/*}/System.map-$kvers"
      do
        [[ -f "$kconfig" ]] || continue
        enchant_install_file "$kconfig" "${target_kernel%/*}/" ||
          return $ERR_INSTALL_KERNEL
      done

      # copy the modules over
      "${ENCHANT_CMD_MKDIR[@]}" "$target_kmods" || return $ERR_INSTALL_KMODS
      enchant_install_dir "$kmods/$kvers" "$target_kmods/" ||
          return $ERR_INSTALL_KMODS

      # make sure that the proper dep info is generated on the target system
      depmod -a -b "$target" "$kvers" ||
        return $ERR_INSTALL_DEPMOD

      # and the firmware the ISO carries for it (network, graphics)
      if [[ -d "$ENCHANT_ISO_FIRMWARE" ]]
      then
        "${ENCHANT_CMD_MKDIR[@]}" "$ENCHANT_TARGET_FIRMWARE" ||
          return $ERR_INSTALL_KMODS
        "${ENCHANT_CMD_INSTALL_DIR[@]}" "$ENCHANT_ISO_FIRMWARE/." \
          "$ENCHANT_TARGET_FIRMWARE/" ||
            return $ERR_INSTALL_KMODS
      fi
      ;;
    *)
      enchant_install_file "$kernel" "$target_kernel" ||
        return $ERR_INSTALL_KERNEL
      ;;
  esac

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param kernel_version (optional, defaults to ENCHANT_ISO_KVERS)
##
## Puts the linux sources into the TARGET's /usr/src, for compiling a custom
## kernel: the tarball from the ISO (ENCHANT_KERNEL_SOURCE) if the ISO carries
## one, else downloaded from ENCHANT_KERNEL_URL (needs network). The sources
## are unpacked to /usr/src/linux-<version> (with a /usr/src/linux link), and
## the ISO kernel's config is put in place as .config to start from.
##
#-------------------------------------------------------------------------------
function enchant_install_kernel_source() {
  local kvers="${1:-$ENCHANT_ISO_KVERS}"
  local ksrc="$ENCHANT_KERNEL_SOURCE"
  local url="$ENCHANT_KERNEL_URL"
  local dst="$ENCHANT_TARGET/usr/src"
  local kconfig="$ENCHANT_ISO_PATH/boot/config-$ENCHANT_ISO_KVERS"

  # a different version than the ISO's: never on the ISO, and the URL differs
  if [[ "$kvers" != "$ENCHANT_ISO_KVERS" ]]
  then
    ksrc="${ksrc//$ENCHANT_ISO_KVERS/$kvers}"
    url="${url//$ENCHANT_ISO_KVERS/$kvers}"
    url="${url//\/v${ENCHANT_ISO_KVERS%%.*}.x\///v${kvers%%.*}.x/}"
  fi

  "${ENCHANT_CMD_MKDIR[@]}" "$dst" || return $ERR_MK_DIR

  if [[ -f "$ksrc" ]]
  then
    libcolor_msg info "Copying ${ksrc##*/} from the ISO"
    "${ENCHANT_CMD_CP[@]}" "$ksrc" "$dst/" || return $ERR_INSTALL_KSRC
  elif [[ ! -f "$dst/${url##*/}" ]]
  then
    libcolor_msg info "Downloading $url"
    "${ENCHANT_CMD_URL_DL[@]}" -O "$dst/${url##*/}.part" "$url" &&
      "${ENCHANT_CMD_MV[@]}" "$dst/${url##*/}.part" "$dst/${url##*/}" ||
        {
          "${ENCHANT_CMD_RM_FORCE[@]}" "$dst/${url##*/}.part"
          return $ERR_INSTALL_KSRC
        }
  fi
  ksrc="$dst/${ksrc##*/}"
  [[ -f "$ksrc" ]] || ksrc="$dst/${url##*/}"

  libcolor_msg info "Unpacking ${ksrc##*/} to /usr/src"
  "${ENCHANT_CMD_TAR[@]}" -C "$dst" -xf "$ksrc" || return $ERR_INSTALL_KSRC
  [[ -d "$dst/linux-$kvers" ]] || return $ERR_INSTALL_KSRC
  "${ENCHANT_CMD_SYMLINK[@]}" -fn "linux-$kvers" "$dst/linux" ||
    return $ERR_INSTALL_KSRC

  if [[ -f "$kconfig" && ! -f "$dst/linux-$kvers/.config" ]]
  then
    "${ENCHANT_CMD_CP[@]}" "$kconfig" "$dst/linux-$kvers/.config" ||
      return $ERR_INSTALL_KSRC
  fi

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param kernel_source (absolute path - e.g. $ENCHANT_ISO_PATH/usr/src/kern.tar)
## @param kernel_arch (architecture to install for - e.g. x86)
##
## Installs the kernel headers into the TARGET's /usr/include/ to be used by the
## system build toolchain for compiling packages from source.
## Requires that / on the TARGET system is mounted.
##
#-------------------------------------------------------------------------------
function enchant_install_kernel_headers_linux() {
  local ksrc="${1:-$ENCHANT_KERNEL_SOURCE}"
  local karch="${2:-$ENCHANT_ARCH}"
  local target="$ENCHANT_TARGET"
  local ksrcd="${ksrc%%.*}"

  [[ -f "$ksrc" ]] || return $ERR_TARGET

  [[ -f "$karch" ]] && karch=$(< "$karch")
  liberror_check || return $ERR_FILE_ACCESS

  # unpack the kernel headers into the target
  "${ENCHANT_CMD_MKDIR[@]}" "$target/usr/src" ||
    return $ERR_MK_DIR
  "${ENCHANT_CMD_TAR[@]}" -C "$target/usr/src" -xf "$ksrc" ||
    return $ERR_INSTALL_KHDRS

  # adjust the arch setting for what linux uses
  case "$karch" in
    x86_64 )
      karch="x86"
      ;;
  esac

  ksrc="${ksrc##*/}"

  # sylink the needed header dirs for the initial install
  for hdir in \
    "arch/$karch/include/asm" \
    "include/uapi/asm-generic" \
    "include/uapi/linux"
  do
    "${ENCHANT_CMD_SYMLINK[@]}" \
      "/usr/src/$ksrcd/$hdir" \
      "$target/usr/include/${hdir##*/}" ||
        return $ERR_SYMLINK_DIR
  done

  # install the headers via kernel makefile in the chroot
  enchant_chroot_init "$target"
  liberror_check || return $?
  enchant_chroot "/usr/src/$ksrcd/make" ARCH="$karch" headers_install
  liberror_check || return $?
  enchant_chroot_done "$target"
  liberror_check || return $?

  # remove the symlinks
  for hlink in asm asm-generic linux
  do
    "${ENCHANT_CMD_RM[@]}" "$target/usr/include/$hlink" ||
      return $ERR_RM_FILE
  done

  # move the kernel headers from the src tree to the target's root
  "${ENCHANT_CMD_MV[@]}" \
    "$target/usr/src/$ksrcd/usr/include/"* \
    "$target/usr/include/" ||
      return $ERR_INSTALL_KHDRS

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param kernel_type (e.g. linux)
##
## Installs the kernel headers into the TARGET's /usr/include/ to be used by the
## system build toolchain for compiling packages from source.
## Requires that / on the TARGET system is mounted.
##
#-------------------------------------------------------------------------------
function enchant_install_kernel_headers() {
  local ktype="${1:-$ENCHANT_KERNEL_TYPE}"

  enchant_install_kernel_headers_"$ktype"
}

