#!/bin/bash
#-------------------------------------------------------------------------------
##
##=head1 SYNOPSIS
##
##  Common functions and variables for different installers related to
##  installing content
##
##=head1 DESCRIPTION
##
##  This is all the functions needed for actually installing content (spell
##  sources, spell caches, kernels and modules, etc.) into a target system.
##
##=head1 COPYRIGHT
##
##  Copyright 2009 The Cauldron Team
##
##=head1 FUNCTIONS
##
##=over 4
##
#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------
##
## @param source
## @param destination
##
## Installs the source file to the destination.
##
#-------------------------------------------------------------------------------
function enchant_install_file() {
  local src="$1"
  local dst="$2"

  [[ -z "$src" ]] && return $ERR_INSTALL_FILE
  [[ -z "$dst" ]] && return $ERR_INSTALL_FILE

  "${ENCHANT_CMD_INSTALL_FILE[@]}" "$src" "$dst" ||
    return $ERR_INSTALL_FILE

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param source
## @param destination
##
## Installs the source directory (including all subdirectories and their
## contents) to the destination.
##
#-------------------------------------------------------------------------------
function enchant_install_dir() {
  local src="$1"
  local dst="$2"

  [[ -z "$src" ]] && return $ERR_INSTALL_DIR
  [[ -z "$dst" ]] && return $ERR_INSTALL_DIR

  "${ENCHANT_CMD_INSTALL_DIR[@]}" "$src" "$dst" ||
    return $ERR_INSTALL_DIR

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param sources_list
##
## Copies the selected spell sources into the target. If sources_list is empty
## (no sources were passed as arguments), it reads the list of sources to
## install from $ENCHANT_SOURCES_LIST.
##
#-------------------------------------------------------------------------------
function enchant_install_sources() {
  local sources=( "$@" )
  local dst="$ENCHANT_TARGET_SOURCES"

  # if no spells were passed in directly, load via the env var
  [[ -n "$sources" ]] || sources=( "${ENCHANT_SOURCES_LIST[@]}" )

  for spell in "${sources[@]}"
  do
    # if the spells are specified via a file, read the file
    if [[ -r "$spell" ]]
    then
      while read s
      do
        enchant_install_file "$ENCHANT_SPELL_SOURCES/$s" "$dst/" ||
          return $ERR_INSTALL_SOURCES
      done < "$spell"
    else
      enchant_install_file "$ENCHANT_SPELL_SOURCES/$spell" "$dst/" ||
        return $ERR_INSTALL_SOURCES
    fi
  done

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param caches_list
##
## Installs the selected spell caches into the target. If caches_list is empty
## (no caches were passed as arguments), it reads the list of caches to
## install from $ENCHANT_CACHES_LIST.
##
## Each cache carries the tablet page of the cast that made it, with the
## answers given then (spell options and optional dependencies). Those answers
## are handed to sorcery in the target, so that it resurrects the caches as
## they are instead of asking again (and defaulting optional dependencies the
## target lacks to "off", although the cached binaries link them). The caches
## of enabled dependencies the target doesn't have yet are added from the ISO.
##
#-------------------------------------------------------------------------------
function enchant_install_caches() {
  local caches=( "$@" )
  local target="$ENCHANT_TARGET"
  local dst="$ENCHANT_TARGET_CACHES"
  local tmp="$ENCHANT_TMP/caches"
  local state="$target/var/state/sorcery"
  local config="$target/etc/sorcery/local/depends"
  local spells=()
  local cache=
  local spell=
  local page=
  local file=
  local dep=
  local index=0

  # if no caches were passed in directly, use the selected ones
  if [[ "${#caches[@]}" -eq 0 && -r "$ENCHANT_CACHES_LIST" ]]
  then
    caches=( $(grep -v '^#' "$ENCHANT_CACHES_LIST") )
  fi
  [[ "${#caches[@]}" -gt 0 ]] || return $ERR_OK

  "${ENCHANT_CMD_MKDIR[@]}" "$dst" "$state/abandoned" "$config" ||
    return $ERR_INSTALL_CACHES

  # (the list grows while looping: dependencies are appended)
  while [[ "$index" -lt "${#caches[@]}" ]]
  do
    cache="${caches[index]}"
    index=$((index+1))

    [[ "$cache" == */* ]] || cache="$ENCHANT_SPELL_CACHES/$cache"
    [[ -f "$cache" ]] || return $ERR_INSTALL_CACHES

    # the tablet page every cache carries: the spell's name and its answers
    "${ENCHANT_CMD_RM_RECURSE_FORCE[@]}" "$tmp" &&
      "${ENCHANT_CMD_MKDIR[@]}" "$tmp" || return $ERR_INSTALL_CACHES
    "${ENCHANT_CMD_TAR[@]}" -xf "$cache" -C "$tmp" --wildcards \
      'var/state/sorcery/tablet/*/*/depends' \
      'var/state/sorcery/tablet/*/*/spell_config*' 2> "$ENCHANT_NULL"
    page=$(ls -d "$tmp"/var/state/sorcery/tablet/*/[0-9]* 2> "$ENCHANT_NULL" |
      sort | tail -n 1)
    [[ -n "$page" ]] || return $ERR_INSTALL_CACHES
    spell="${page%/*}"
    spell="${spell##*/}"

    "${ENCHANT_CMD_CP[@]}" "$cache" "$dst/" || return $ERR_INSTALL_CACHES
    spells+=( "$spell" )

    for file in spell_config spell_config.p
    do
      [[ -f "$page/$file" ]] || continue
      "${ENCHANT_CMD_CP[@]}" "$page/$file" "$config/$spell${file#spell_config}" ||
        return $ERR_INSTALL_CACHES
    done
    [[ -f "$page/depends" ]] || continue
    "${ENCHANT_CMD_CP[@]}" "$page/depends" "$state/abandoned/$spell" ||
      return $ERR_INSTALL_CACHES

    # enabled dependencies (spell:dependency(provider):on:...) that the target
    # doesn't have and that aren't queued yet
    for dep in $(awk -F: '$3 == "on" { sub(/\(.*/, "", $2); print $2 }' \
      "$page/depends")
    do
      grep -q "^$dep:" "$state/packages" 2> "$ENCHANT_NULL" && continue
      [[ " ${spells[*]} ${caches[*]##*/} " == *" $dep"[-\ ]* ]] && continue

      file=$(ls "$ENCHANT_SPELL_CACHES/$dep"-[0-9]*.tar.* 2> "$ENCHANT_NULL" |
        head -n 1)
      if [[ -n "$file" ]]
      then
        libcolor_msg info "$spell needs $dep: adding ${file##*/}"
        caches+=( "$file" )
      else
        libcolor_msg warn \
          "$spell needs $dep, which has no cache here: sorcery will build it"
      fi
    done
  done
  "${ENCHANT_CMD_RM_RECURSE_FORCE[@]}" "$tmp"

  # let sorcery in the target install them, so that it knows about them (it
  # resurrects the caches rather than compiling, since the target's grimoire
  # has the same spell versions); the answers are already there, so don't wait
  # PROMPT_DELAY at every question
  enchant_chroot_init "$target"
  liberror_check || return $?
  enchant_chroot env PROMPT_DELAY="${PROMPT_DELAY:-0}" cast "${spells[@]}"
  liberror_check || return $ERR_INSTALL_CACHES
  enchant_chroot_done "$target"
  liberror_check || return $?

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param sys iaage archive file
##
## Unpacks the given sys image to the target system. If the sys image is not
## specified, it defaults to ENCHANT_SYSTEM_ARCHIVE.
##
#-------------------------------------------------------------------------------
function enchant_install_system() {
  local sys="${1:-$ENCHANT_SYSTEM_ARCHIVE}"
  local dst="$ENCHANT_TARGET"

  # ensure that the sys image is a file
  [[ -f "$sys" ]] || return $ERR_INSTALL_SYSTEM

  "${ENCHANT_CMD_TAR[@]}" -C "$dst" -xf "$sys" ||
    return $ERR_INSTALL_SYSTEM

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param kernel_image (absolute path - e.g. $ENCHANT_ISO_PATH/boot/kernel)
## @param modules_path (absolute path - e.g. $ENCHANT_ISO_PATH/lib/modules)
## @param kernel_version (e.g. 6.18.59)
## @param kernel_type (e.g. linux)
##
## Copies the kernel and it's associated modules from the ISO to the TARGET
## system. Requires that / and /boot on the TARGET system are mounted (unless
## ENCHANT_TARGET_KERNEL and ENCHANT_TARGET_KMODS are modified). The modules
## are taken from modules_path/kernel_version. A linux kernel is installed as
## ENCHANT_TARGET_KERNEL-kernel_version (the name grub-mkconfig looks for),
## together with its config-kernel_version if there is one next to the image.
##
#-------------------------------------------------------------------------------
function enchant_install_kernel() {
  local target="$ENCHANT_TARGET"
  local target_kernel="$ENCHANT_TARGET_KERNEL"
  local target_kmods="$ENCHANT_TARGET_KMODS"
  local kernel="${1:-$ENCHANT_ISO_KERNEL}"
  local kmods="${2:-$ENCHANT_ISO_KMODS}"
  local kvers="${3:-$ENCHANT_ISO_KVERS}"
  local ktype="${4:-$ENCHANT_KERNEL_TYPE}"
  local kconfig=

  # the image may be a symlink (/boot/kernel on the ISO); copy what it points to
  kernel=$("${ENCHANT_CMD_READLINK[@]}" "$kernel") || return $ERR_INSTALL_KERNEL

  case "$ktype" in
    linux)
      enchant_install_file "$kernel" "$target_kernel-$kvers" ||
        return $ERR_INSTALL_KERNEL

      kconfig="${kernel%/*}/config-$kvers"
      if [[ -f "$kconfig" ]]
      then
        enchant_install_file "$kconfig" "${target_kernel%/*}/" ||
          return $ERR_INSTALL_KERNEL
      fi

      # copy the modules over
      "${ENCHANT_CMD_MKDIR[@]}" "$target_kmods" || return $ERR_INSTALL_KMODS
      enchant_install_dir "$kmods/$kvers" "$target_kmods/" ||
          return $ERR_INSTALL_KMODS

      # make sure that the proper dep info is generated on the target system
      depmod -a -b "$target" "$kvers" ||
        return $ERR_INSTALL_DEPMOD
      ;;
    *)
      enchant_install_file "$kernel" "$target_kernel" ||
        return $ERR_INSTALL_KERNEL
      ;;
  esac

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param kernel_version (optional, defaults to ENCHANT_ISO_KVERS)
##
## Puts the linux sources into the TARGET's /usr/src, for compiling a custom
## kernel: the tarball from the ISO (ENCHANT_KERNEL_SOURCE) if the ISO carries
## one, else downloaded from ENCHANT_KERNEL_URL (needs network). The sources
## are unpacked to /usr/src/linux-<version> (with a /usr/src/linux link), and
## the ISO kernel's config is put in place as .config to start from.
##
#-------------------------------------------------------------------------------
function enchant_install_kernel_source() {
  local kvers="${1:-$ENCHANT_ISO_KVERS}"
  local ksrc="$ENCHANT_KERNEL_SOURCE"
  local url="$ENCHANT_KERNEL_URL"
  local dst="$ENCHANT_TARGET/usr/src"
  local kconfig="$ENCHANT_ISO_PATH/boot/config-$ENCHANT_ISO_KVERS"

  # a different version than the ISO's: never on the ISO, and the URL differs
  if [[ "$kvers" != "$ENCHANT_ISO_KVERS" ]]
  then
    ksrc="${ksrc//$ENCHANT_ISO_KVERS/$kvers}"
    url="${url//$ENCHANT_ISO_KVERS/$kvers}"
    url="${url//\/v${ENCHANT_ISO_KVERS%%.*}.x\///v${kvers%%.*}.x/}"
  fi

  "${ENCHANT_CMD_MKDIR[@]}" "$dst" || return $ERR_MK_DIR

  if [[ -f "$ksrc" ]]
  then
    libcolor_msg info "Copying ${ksrc##*/} from the ISO"
    "${ENCHANT_CMD_CP[@]}" "$ksrc" "$dst/" || return $ERR_INSTALL_KSRC
  elif [[ ! -f "$dst/${url##*/}" ]]
  then
    libcolor_msg info "Downloading $url"
    "${ENCHANT_CMD_URL_DL[@]}" -O "$dst/${url##*/}.part" "$url" &&
      "${ENCHANT_CMD_MV[@]}" "$dst/${url##*/}.part" "$dst/${url##*/}" ||
        {
          "${ENCHANT_CMD_RM_FORCE[@]}" "$dst/${url##*/}.part"
          return $ERR_INSTALL_KSRC
        }
  fi
  ksrc="$dst/${ksrc##*/}"
  [[ -f "$ksrc" ]] || ksrc="$dst/${url##*/}"

  libcolor_msg info "Unpacking ${ksrc##*/} to /usr/src"
  "${ENCHANT_CMD_TAR[@]}" -C "$dst" -xf "$ksrc" || return $ERR_INSTALL_KSRC
  [[ -d "$dst/linux-$kvers" ]] || return $ERR_INSTALL_KSRC
  "${ENCHANT_CMD_SYMLINK[@]}" -fn "linux-$kvers" "$dst/linux" ||
    return $ERR_INSTALL_KSRC

  if [[ -f "$kconfig" && ! -f "$dst/linux-$kvers/.config" ]]
  then
    "${ENCHANT_CMD_CP[@]}" "$kconfig" "$dst/linux-$kvers/.config" ||
      return $ERR_INSTALL_KSRC
  fi

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param kernel_source (absolute path - e.g. $ENCHANT_ISO_PATH/usr/src/kern.tar)
## @param kernel_arch (architecture to install for - e.g. x86)
##
## Installs the kernel headers into the TARGET's /usr/include/ to be used by the
## system build toolchain for compiling packages from source.
## Requires that / on the TARGET system is mounted.
##
#-------------------------------------------------------------------------------
function enchant_install_kernel_headers_linux() {
  local ksrc="${1:-$ENCHANT_KERNEL_SOURCE}"
  local karch="${2:-$ENCHANT_ARCH}"
  local target="$ENCHANT_TARGET"
  local ksrcd="${ksrc%%.*}"

  [[ -f "$ksrc" ]] || return $ERR_TARGET

  [[ -f "$karch" ]] && karch=$(< "$karch")
  liberror_check || return $ERR_FILE_ACCESS

  # unpack the kernel headers into the target
  "${ENCHANT_CMD_MKDIR[@]}" "$target/usr/src" ||
    return $ERR_MK_DIR
  "${ENCHANT_CMD_TAR[@]}" -C "$target/usr/src" -xf "$ksrc" ||
    return $ERR_INSTALL_KHDRS

  # adjust the arch setting for what linux uses
  case "$karch" in
    x86_64 )
      karch="x86"
      ;;
  esac

  ksrc="${ksrc##*/}"

  # sylink the needed header dirs for the initial install
  for hdir in \
    "arch/$karch/include/asm" \
    "include/uapi/asm-generic" \
    "include/uapi/linux"
  do
    "${ENCHANT_CMD_SYMLINK[@]}" \
      "/usr/src/$ksrcd/$hdir" \
      "$target/usr/include/${hdir##*/}" ||
        return $ERR_SYMLINK_DIR
  done

  # install the headers via kernel makefile in the chroot
  enchant_chroot_init "$target"
  liberror_check || return $?
  enchant_chroot "/usr/src/$ksrcd/make" ARCH="$karch" headers_install
  liberror_check || return $?
  enchant_chroot_done "$target"
  liberror_check || return $?

  # remove the symlinks
  for hlink in asm asm-generic linux
  do
    "${ENCHANT_CMD_RM[@]}" "$target/usr/include/$hlink" ||
      return $ERR_RM_FILE
  done

  # move the kernel headers from the src tree to the target's root
  "${ENCHANT_CMD_MV[@]}" \
    "$target/usr/src/$ksrcd/usr/include/"* \
    "$target/usr/include/" ||
      return $ERR_INSTALL_KHDRS

  return $ERR_OK
}

#-------------------------------------------------------------------------------
##
## @param kernel_type (e.g. linux)
##
## Installs the kernel headers into the TARGET's /usr/include/ to be used by the
## system build toolchain for compiling packages from source.
## Requires that / on the TARGET system is mounted.
##
#-------------------------------------------------------------------------------
function enchant_install_kernel_headers() {
  local ktype="${1:-$ENCHANT_KERNEL_TYPE}"

  enchant_install_kernel_headers_"${!ktype}"
}

