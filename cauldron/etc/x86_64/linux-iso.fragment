# Cauldron ISO kernel: settings applied on top of the kernel's
# x86_64_defconfig. The full config used by cauldron
# (linux-<version>.config next to this file) is generated from it with:
#
#   cd /usr/src/linux-<version>
#   make x86_64_defconfig
#   scripts/kconfig/merge_config.sh -m .config <this file>
#   make olddefconfig
#
# Rule of thumb: anything the initramfs needs to find and mount the boot
# medium is built in (=y), so booting never depends on loading modules; extra
# hardware and filesystems the installer may need are modules (=m).

# general
CONFIG_LOCALVERSION=""
CONFIG_LOCALVERSION_AUTO=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_COMPRESS=n
CONFIG_MODULE_SIG=n
CONFIG_DEBUG_INFO_NONE=y
# not needed for anything on the ISO (and needs a Rust toolchain)
# CONFIG_RUST is not set

# initramfs, devices
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# boot medium: CD (iso9660/udf), USB stick, squashfs live image + overlay
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_SR=y
CONFIG_CHR_DEV_SG=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# disks
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_MD=y
CONFIG_BLK_DEV_MD=m
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_DM_SNAPSHOT=m
CONFIG_DM_MIRROR=m
CONFIG_DM_RAID=m
CONFIG_CRYPTO_XTS=m
CONFIG_CRYPTO_AES_NI_INTEL=m

# filesystems the installer can create / mount
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
# castfs (sorcery's staged installs) uses fuse
CONFIG_FUSE_FS=y

# UEFI
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_PARTITION=y
CONFIG_EFIVAR_FS=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# turn the console to match panels mounted sideways (the orientation comes from
# the GPU driver or the kernel's quirk list; fbcon=rotate:N overrides it)
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
# a 16x32 console font, which the kernel picks by itself on high resolution
# screens (the default 8x16 font is tiny on a dense laptop panel)
CONFIG_FONTS=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# virtual machines
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# common wired network cards
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_TIGON3=m
CONFIG_BNX2=m
CONFIG_ATL1C=m
CONFIG_ALX=m
CONFIG_8139CP=m
CONFIG_8139TOO=m

# USB network: Ethernet adapters and phones (USB tethering), for machines
# without a wired port
CONFIG_USB_USBNET=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_IPHETH=m

# wireless: the common laptop chips (their firmware is copied to the ISO's
# /lib/firmware, see CAULDRON_ISO_FIRMWARE); cfg80211 is built in, so its
# regulatory database is read from /lib/firmware/regulatory.db
CONFIG_WLAN=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLMLD=m
CONFIG_IWLDVM=m
CONFIG_RTW88=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8723DE=m
CONFIG_RTW89=m
CONFIG_RTW89_8852AE=m
CONFIG_RTW89_8852BE=m
CONFIG_RTW89_8852CE=m
CONFIG_RTW89_8922AE=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_ATH12K=m
CONFIG_ATH9K=m
CONFIG_MT7921E=m
CONFIG_MT7925E=m
CONFIG_BRCMFMAC=m
CONFIG_RTL8XXXU=m
CONFIG_RTW88_8821CU=m
CONFIG_RTW88_8822BU=m
CONFIG_MT7921U=m

# bluetooth (not needed to install, but the hardware is common)
CONFIG_BT=m
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_INTEL=m

# Intel graphics as a module: its GuC/DMC firmware lives in /lib/firmware on
# the live system, which a built-in i915 probes too early to see (it then
# disables the GPU: "declaring it wedged"); simpledrm/efifb show the console
# until it loads
CONFIG_DRM_I915=m

# laptop platform devices behind the Intel LPSS I2C/SPI controllers: touchpads
# and touchscreens (HID over I2C), accelerometers; and SD card readers
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_MFD_INTEL_LPSS_ACPI=m
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_I2C_DESIGNWARE_PCI=m
# (the GPIO/pinctrl drivers provide the interrupts of I2C touchpads)
CONFIG_GPIOLIB=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ALDERLAKE=y
CONFIG_PINCTRL_TIGERLAKE=y
CONFIG_PINCTRL_METEORLAKE=y
CONFIG_PINCTRL_JASPERLAKE=y
CONFIG_PINCTRL_ELKHARTLAKE=y
CONFIG_PINCTRL_INTEL_PLATFORM=y
CONFIG_I2C_HID_ACPI=m
CONFIG_HID_MULTITOUCH=m
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_IIO=m
CONFIG_MXC4005=m
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MMC_BLOCK=m
