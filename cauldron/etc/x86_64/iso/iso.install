# Spell caches shipped on the ISO (isofs/var/cache/sorcery) that the installer
# can add to the installed system on top of system.tar.xz. Their dependency
# closure is shipped too, minus spells already in system.tar.xz.

# boot loader (the grub2 cache carries both the BIOS and the UEFI platform)
grub2
efibootmgr
dosfstools

# storage
mdadm
lvm
cryptsetup-luks
xfsprogs
btrfs-progs

# network / remote access
openssh

# administration as a regular user (sudo; opendoas needs a system logger,
# so it is left to the installed system: cast opendoas)
sudo

# laptops: battery charge in a console (acpi -b)
acpi

# editors (the base system has nano)
vim
jed

# development: git is left out for now; the grimoire's git (2.56.0) depends on
# rust (and so llvm), which would have to be built and shipped too
