# /etc/fstab of the live ISO environment. The root filesystem (an overlay of
# the squashfs image and a tmpfs) is set up by the initramfs, so it is not
# listed here.
proc      /proc     proc      defaults           0 0
sysfs     /sys      sysfs     defaults           0 0
devpts    /dev/pts  devpts    gid=5,mode=620     0 0
tmpfs     /tmp      tmpfs     defaults,mode=1777 0 0
