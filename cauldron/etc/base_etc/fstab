# /etc/fstab: static file system information, read by "mount -a" at boot.
# <device> <mount point> <type> <options> <dump> <pass>
#   dump: 0 (backup flag, unused)
#   pass: fsck order: 1 = the root filesystem, 2 = other filesystems checked
#         at boot, 0 = never (btrfs, vfat with care, swap, virtual ones)

# Virtual filesystems (SMGL's boot scripts mount these from here: keep them)
proc    /proc           proc    defaults                0 0
sysfs   /sys            sysfs   defaults                0 0
devpts  /dev/pts        devpts  gid=5,mode=620          0 0
# POSIX shared memory (needed by many programs)
tmpfs   /dev/shm        tmpfs   defaults                0 0

# Add your file systems here.

# Examples (uncomment and adjust; "lsblk -f" lists devices, labels, UUIDs).
# A device can be named /dev/nvme0n1p2, LABEL=smgl, UUID=... or PARTUUID=...
#
# ext4 root:
#/dev/nvme0n1p2  /            ext4   defaults,noatime                  0 1
# XFS root:
#/dev/nvme0n1p2  /            xfs    defaults,noatime                  0 1
# btrfs root with subvolumes (see "guide disks" on the install ISO):
#/dev/nvme0n1p2  /            btrfs  subvol=@,compress=zstd,noatime          0 0
#/dev/nvme0n1p2  /home        btrfs  subvol=@home,compress=zstd,noatime      0 0
#/dev/nvme0n1p2  /var/log     btrfs  subvol=@log,compress=zstd,noatime       0 0
#/dev/nvme0n1p2  /.snapshots  btrfs  subvol=@snapshots,compress=zstd,noatime 0 0
# EFI system partition (UEFI machines):
#/dev/nvme0n1p1  /boot/efi    vfat   defaults,umask=0077               0 2
# a separate /home:
#LABEL=home      /home        ext4   defaults,noatime                  0 2
# swap partition, or swap file (btrfs: a file in its own subvolume):
#/dev/nvme0n1p3  none         swap   sw                                0 0
#/swapfile       none         swap   sw                                0 0
# /tmp in RAM (emptied at every boot; size= caps it):
#tmpfs           /tmp         tmpfs  defaults,size=2G,mode=1777        0 0

# Order matters: a mount point must come after the filesystem it lives on
# (e.g. / before /home, /usr before /usr/local).
# More: "man 5 fstab", and fstab.examples next to this file.
