# /etc/network/interfaces: read by ifup/ifdown (ifupdown), which SMGL's
# "network" boot script runs as "ifup -a" (every "auto" interface below).
# "ip link" lists the interface names; "man interfaces" has all options.

auto lo
iface lo inet loopback

