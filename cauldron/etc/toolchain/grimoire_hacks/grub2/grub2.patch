--- var/lib/sorcery/codex/test/disk/grub2/grub-default
+++ var/lib/sorcery/codex/test/disk/grub2/grub-default
@@ -8,12 +8,14 @@
 GRUB_GFXMODE=1024x768
 # Add recovery items (single mode)
 GRUB_DISABLE_RECOVERY=
-# Booting using UUID's appears broken
-GRUB_DISABLE_UUID=true
+# root=UUID= needs an initramfs; root=PARTUUID= works without one
+GRUB_DISABLE_LINUX_UUID=true
+GRUB_DISABLE_LINUX_PARTUUID=false
 # We rule ;)
 GRUB_DISTRIBUTOR="Source Mage"
 
-# show the splash image
-GRUB_BACKGROUND="smgl-splash.png"
+# show the splash image (installed there by this spell; grub-mkconfig needs
+# the full path, and a font for the graphical menu: /boot/grub/fonts)
+GRUB_BACKGROUND="/boot/grub/smgl-splash.png"
 #GRUB_THEME=""
 GRUB_CMDLINE_LINUX_DEFAULT=""
