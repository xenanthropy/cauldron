--- var/lib/sorcery/codex/test/disk/grub2/DEPENDS
+++ var/lib/sorcery/codex/test/disk/grub2/DEPENDS
@@ -23,7 +23,12 @@
                   '--disable-grub-mkfont'    \
                   'for grub-mkfont utility' &&
 
-optional_depends  unifont  '' '' 'for the default font (needed for gfxterm)' &&
+# GRUB's configure only looks for unifont.{pcf,bdf,ttf}; the unifont spell
+# installs an .otf, so name it (freetype2 reads it; it becomes unicode.pf2)
+optional_depends  unifont                    \
+                  '--with-unifont=/usr/share/fonts/unifont/unifont.otf' \
+                  ''                         \
+                  'for the default font (needed for gfxterm)' &&
 
 optional_depends  sdl \
                   '--enable-grub-emu-sdl' \
--- var/lib/sorcery/codex/test/disk/grub2/grub-default
+++ var/lib/sorcery/codex/test/disk/grub2/grub-default
@@ -5,15 +5,18 @@
 # Hidden menu timeout
 GRUB_HIDDEN_TIMEOUT=0
 # Graphics mode
-GRUB_GFXMODE=1024x768
+GRUB_GFXMODE=auto
 # Add recovery items (single mode)
 GRUB_DISABLE_RECOVERY=
-# Booting using UUID's appears broken
-GRUB_DISABLE_UUID=true
+# root=UUID= needs an initramfs; root=PARTUUID= works without one
+GRUB_DISABLE_LINUX_UUID=true
+GRUB_DISABLE_LINUX_PARTUUID=false
 # We rule ;)
 GRUB_DISTRIBUTOR="Source Mage"
 
-# show the splash image
-GRUB_BACKGROUND="smgl-splash.png"
-#GRUB_THEME=""
+# the graphical menu: the theme of Source Mage's install ISO (Quoth on
+# black; installed by this spell), which needs a font in /boot/grub/fonts
+# (grub-install copies unicode.pf2 there). Instead of the theme, a plain
+# background image: GRUB_BACKGROUND="/boot/grub/smgl-splash.png"
+GRUB_THEME="/usr/share/grub/themes/smgl/theme.txt"
 GRUB_CMDLINE_LINUX_DEFAULT=""
--- var/lib/sorcery/codex/test/disk/grub2/INSTALL
+++ var/lib/sorcery/codex/test/disk/grub2/INSTALL
@@ -5,4 +5,11 @@
 
 GRUBDIR=${INSTALL_ROOT}/boot/grub &&
 mkdir -p $GRUBDIR &&
-install ${SPELL_DIRECTORY}/smgl-splash.png $GRUBDIR
+install ${SPELL_DIRECTORY}/smgl-splash.png $GRUBDIR &&
+
+# the theme of Source Mage's install ISO (cauldron copies it into the spell)
+if [[ -d ${SPELL_DIRECTORY}/theme-smgl ]]; then
+  mkdir -p ${INSTALL_ROOT}/usr/share/grub/themes/smgl &&
+  install -m 644 ${SPELL_DIRECTORY}/theme-smgl/* \
+    ${INSTALL_ROOT}/usr/share/grub/themes/smgl/
+fi
