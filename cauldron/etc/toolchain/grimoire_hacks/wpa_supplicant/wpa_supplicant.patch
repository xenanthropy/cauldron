diff -ruN a/var/lib/sorcery/codex/test/net/wpa_supplicant/PRE_BUILD b/var/lib/sorcery/codex/test/net/wpa_supplicant/PRE_BUILD
--- var/lib/sorcery/codex/test/net/wpa_supplicant/PRE_BUILD
+++ var/lib/sorcery/codex/test/net/wpa_supplicant/PRE_BUILD
@@ -1,6 +1,9 @@
 default_pre_build &&
 cd "$SOURCE_DIRECTORY" &&
 
+# OpenSSL 4 made ASN1_STRING opaque (fixed by distributions, not upstream yet)
+patch -p1 < "$SPELL_DIRECTORY/openssl4.patch" &&
+
 sed -i "s|/usr/local|$INSTALL_ROOT/usr|g" wpa_supplicant/Makefile &&
 
 if [[ -z $QTDIR ]] && is_depends_enabled $SPELL qt-x11; then
diff -ruN a/var/lib/sorcery/codex/test/net/wpa_supplicant/openssl4.patch b/var/lib/sorcery/codex/test/net/wpa_supplicant/openssl4.patch
--- var/lib/sorcery/codex/test/net/wpa_supplicant/openssl4.patch
+++ var/lib/sorcery/codex/test/net/wpa_supplicant/openssl4.patch
@@ -0,0 +1,60 @@
+# OpenSSL 4 made ASN1_STRING opaque: use its accessors (Source Mage cauldron)
+--- a/src/crypto/tls_openssl.c	2024-07-20 18:04:37.000000000 +0000
++++ b/src/crypto/tls_openssl.c	2026-10-30 00:26:39.313222607 +0000
+@@ -1854,8 +1854,8 @@
+ 		gen = sk_GENERAL_NAME_value(ext, i);
+ 		if (gen->type != type)
+ 			continue;
+-		if (os_strlen((char *) gen->d.ia5->data) == len &&
+-		    os_memcmp(value, gen->d.ia5->data, len) == 0)
++		if (os_strlen((char *) ASN1_STRING_get0_data(gen->d.ia5)) == len &&
++		    os_memcmp(value, ASN1_STRING_get0_data(gen->d.ia5), len) == 0)
+ 			found++;
+ 	}
+ 
+@@ -2176,10 +2176,10 @@
+ 			continue;
+ 		dns_name++;
+ 		wpa_hexdump_ascii(MSG_DEBUG, "TLS: Certificate dNSName",
+-				  gen->d.dNSName->data,
+-				  gen->d.dNSName->length);
+-		if (domain_suffix_match(gen->d.dNSName->data,
+-					gen->d.dNSName->length,
++				  ASN1_STRING_get0_data(gen->d.dNSName),
++				  ASN1_STRING_length(gen->d.dNSName));
++		if (domain_suffix_match(ASN1_STRING_get0_data(gen->d.dNSName),
++					ASN1_STRING_length(gen->d.dNSName),
+ 					match, match_len, full) == 1) {
+ 			wpa_printf(MSG_DEBUG, "TLS: %s in dNSName found",
+ 				   full ? "Match" : "Suffix match");
+@@ -2210,8 +2210,8 @@
+ 		if (cn == NULL)
+ 			continue;
+ 		wpa_hexdump_ascii(MSG_DEBUG, "TLS: Certificate commonName",
+-				  cn->data, cn->length);
+-		if (domain_suffix_match(cn->data, cn->length,
++				  ASN1_STRING_get0_data(cn), ASN1_STRING_length(cn));
++		if (domain_suffix_match(ASN1_STRING_get0_data(cn), ASN1_STRING_length(cn),
+ 					match, match_len, full) == 1) {
+ 			wpa_printf(MSG_DEBUG, "TLS: %s in commonName found",
+ 				   full ? "Match" : "Suffix match");
+@@ -2420,7 +2420,7 @@
+ 		    gen->type != GEN_URI)
+ 			continue;
+ 
+-		pos = os_malloc(10 + gen->d.ia5->length + 1);
++		pos = os_malloc(10 + ASN1_STRING_length(gen->d.ia5) + 1);
+ 		if (pos == NULL)
+ 			break;
+ 		altsubject[num_altsubject++] = pos;
+@@ -2440,8 +2440,8 @@
+ 			break;
+ 		}
+ 
+-		os_memcpy(pos, gen->d.ia5->data, gen->d.ia5->length);
+-		pos += gen->d.ia5->length;
++		os_memcpy(pos, ASN1_STRING_get0_data(gen->d.ia5), ASN1_STRING_length(gen->d.ia5));
++		pos += ASN1_STRING_length(gen->d.ia5);
+ 		*pos = '\0';
+ 	}
+ 	sk_GENERAL_NAME_pop_free(ext, GENERAL_NAME_free);
