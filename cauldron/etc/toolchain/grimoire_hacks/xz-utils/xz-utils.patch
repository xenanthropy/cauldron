 #!/bin/bash
-# fix obsolete references to liblzma.la
-sed -i 's|/usr/lib/liblzma.la|-llzma|g' {/usr,}/lib/*\.la
+# fix obsolete references to liblzma.la, in the .la files that exist (with
+# none in /lib or /usr/lib the glob stayed literal, sed failed and so did the
+# cast, and with it every spell depending on xz-utils)
+for LIBLZMA_LA in /usr/lib/*.la /lib/*.la; do
+  [[ -f $LIBLZMA_LA ]] || continue
+  sed -i 's|/usr/lib/liblzma.la|-llzma|g' "$LIBLZMA_LA"
+done
+true
