--- var/lib/sorcery/codex/test/disk/eudev/INSTALL	2026-11-11 18:50:01.976423027 +0000
+++ var/lib/sorcery/codex/test/disk/eudev/INSTALL	2026-11-11 18:50:01.993537013 +0000
@@ -7,6 +7,13 @@
                   "$UDEV_CFG/rules.d" &&
 
 for file in $SPELL_DIRECTORY/rules/*; do
+  # 52-modules.rules runs modprobe for every device alias, for udev without
+  # kmod support; with it, 80-drivers.rules loads modules itself, and the
+  # extra modprobe runs only fail and log it (eudev 3.3: on the console)
+  if [[ ${file##*/} == 52-modules.rules ]] && is_depends_enabled $SPELL kmod
+  then
+    continue
+  fi
   install_config_file $file "$UDEV_CFG/rules.d/$(basename $file)"
 done &&
 
@@ -16,4 +23,11 @@
 install_config_file "$SPELL_DIRECTORY/modprobe.aliases" \
                     "$INSTALL_ROOT/etc/modprobe.d/udev.conf" &&
 
-default_install
+default_install &&
+
+# eudev 3.3 installs udevadm in /bin only (3.2 also put it in /sbin), but
+# the spell's coldplug boot script runs /sbin/udevadm: without this link a
+# system upgraded to 3.3 stops at "Essential script failed" at the next boot
+if [[ ! -e "$INSTALL_ROOT/sbin/udevadm" ]]; then
+  ln -s ../bin/udevadm "$INSTALL_ROOT/sbin/udevadm"
+fi
